# Server
PORT=3000
ONLINE_TIMEOUT_SECONDS=12
APP_TIMEZONE=Asia/Jakarta

# Kunci keamanan ESP32 (harus sama dengan sketch ESP32)
DEVICE_API_KEY=GANTI_DENGAN_DEVICE_API_KEY_ANDA

# Supabase (Cloud PostgreSQL & Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simulator lokal
SIMULATOR_API_URL=http://127.0.0.1:3000/api/telemetry
SIMULATOR_INTERVAL_MS=3000
